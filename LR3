from enum import Enum
from dataclasses import dataclass
from datetime import datetime

# 1. Enum для спеціалізацій
class DoctorSpecialty(Enum):
    THERAPIST = "1"
    STOMATOLOGIST = "2"
    CARDIOLOGIST = "3"

# Специфіка: Dataclass для картки пацієнта
@dataclass
class PatientCard:
    full_name: str
    age: int
    blood_group: str
class Appointment:
    def __init__(self, patient: PatientCard, specialty: DoctorSpecialty, time_str: str, cost: float):
        # 5. Архітектурний краш-тест
        if patient.age <= 0 or patient.age > 120:
            raise ValueError(f"Некоректний вік: {patient.age}. Пацієнт має бути живою людиною!")
        if cost < 0:
            raise ValueError(f"Ціна {cost} не може бути від'ємною!")
        
        self.patient = patient
        self.specialty = specialty
        # Перетворюємо рядок у формат часу для сортування
        self.time = datetime.strptime(time_str, "%H:%M")
        self.cost = cost

    # Специфіка: Сортування за часом
    def __lt__(self, other):
        return self.time < other.time

    def get_info(self):
        return f"{self.time.strftime('%H:%M')} | {self.patient.full_name}"
class Consultation(Appointment):
    def __init__(self, patient, specialty, time, cost, reason):
        super().__init__(patient, specialty, time, cost)
        self.reason = reason

    def get_info(self): # Поліморфізм
        return f"[Консультація] {super().get_info()} (Причина: {self.reason})"

class Procedure(Appointment):
    def __init__(self, patient, specialty, time, cost, room):
        super().__init__(patient, specialty, time, cost)
        self.room = room

    def get_info(self): # Поліморфізм
        return f"[Процедура]    {super().get_info()} (Кабінет: {self.room})"
class ClinicRegistry:
    def __init__(self):
        self.appointments = []

    def add(self, app):
        self.appointments.append(app)
        self.appointments.sort() # Авто-сортування завдяки __lt__

    def show(self):
        print("\n=== ГРАФІК ПРИЙОМІВ ===")
        for a in self.appointments:
            print(a.get_info())
def main():
    registry = ClinicRegistry()
    
    while True:
        print("\n--- Додавання нового запису (або 'exit' для виходу) ---")
        name = input("ПІБ пацієнта: ")
        if name.lower() == 'exit': break
        
        try:
            age = int(input("Вік: "))
            blood = input("Група крові: ")
            time = input("Час (ГГ:ХХ): ")
            price = float(input("Вартість: "))
            
            # Створюємо картку
            card = PatientCard(name, age, blood)
            
            print("Тип: 1 - Консультація, 2 - Процедура")
            choice = input("Вибір: ")
            
            if choice == "1":
                reason = input("Причина візиту: ")
                record = Consultation(card, DoctorSpecialty.THERAPIST, time, price, reason)
            else:
                room = input("Номер кабінету: ")
                record = Procedure(card, DoctorSpecialty.THERAPIST, time, price, room)
            
            registry.add(record)
            print("✅ Запис успішно додано!")
            
        except ValueError as e:
            # Ось тут ми ловимо помилки з нашого "Краш-тесту"
            print(f"❌ ПОМИЛКА ДАНИХ: {e}")
        except Exception as e:
            print(f"❌ Щось пішло не так: {e}")

    registry.show()

if __name__ == "__main__":
    main()
